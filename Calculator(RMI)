//Palindrome
int temp = n, rev = 0;

while(n > 0) {
    int d = n % 10;
    rev = rev * 10 + d;
    n /= 10;
}

System.out.println(temp == rev ? "Palindrome" : "Not Palindrome");
//Armstrong
int temp = n, sum = 0;

while(n > 0) {
    int d = n % 10;
    sum += d * d * d;
    n /= 10;
}

System.out.println(temp == sum ? "Armstrong" : "Not Armstrong");
